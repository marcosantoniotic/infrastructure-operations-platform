{
  "uid": "iop-profiles-overview",
  "title": "IOP · Visão geral",
  "tags": [
    "iop",
    "technical-profile-groups",
    "candidate"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "profile",
        "label": "Perfil / grupo técnico",
        "type": "custom",
        "query": "Linux : IOP - Linux,Windows : IOP - Windows,ICMP : IOP - ICMP",
        "multi": false,
        "includeAll": true,
        "allValue": "IOP - (Linux|Windows|ICMP)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "host",
        "label": "Equipamento",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "iop-zabbix-readonly"
        },
        "query": {
          "queryType": "host",
          "group": "/^${profile:regex}$/",
          "host": "/.*/"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "IOP · Visão geral | Saúde e capacidade",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**LABORATÓRIO SINTÉTICO · PLUGIN OFICIAL ASSINADO** — Perfil → grupo técnico → equipamento. Sem coleta ≠ saudável; serviço parado ≠ falha."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disponibilidade",
      "description": "Seleção pelo grupo técnico mantido pelo sincronizador; sem dependência de hostTags do plugin.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "iop-zabbix-readonly"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "iop-zabbix-readonly"
          },
          "schema": 13,
          "queryType": "0",
          "group": {
            "filter": "/^${profile:regex}$/"
          },
          "host": {
            "filter": "/^${host:regex}$/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/^ICMP ping$/"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ],
                "defaultParams": []
              },
              "params": [
                "$__zbx_host_name"
              ],
              "text": "setAlias($__zbx_host_name)"
