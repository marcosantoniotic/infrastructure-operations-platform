        "defaults": {
          "unit": "short",
          "noValue": "Sem coleta",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false,
            "lineInterpolation": "smooth"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
