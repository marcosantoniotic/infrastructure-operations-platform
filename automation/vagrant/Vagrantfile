# frozen_string_literal: true

require "json"

Vagrant.configure("2") do |config|
  project_root = File.expand_path("../..", __dir__)
  validation_root = File.join(project_root, ".validation")
  local_config_path = File.join(validation_root, "vagrant.json")

  unless File.file?(local_config_path)
    raise "Missing #{local_config_path}. Run Initialize-Validation.ps1 first."
  end

  local_config = JSON.parse(File.read(local_config_path))
  private_key = ENV.fetch(
    "VALIDATION_SSH_PRIVATE_KEY",
    File.join(validation_root, "id_ed25519")
  )

  config.vm.box = "infrastructure-operations-platform/rhel9.8"
  config.vm.box_check_update = false

  config.ssh.username = "automation"
  config.ssh.private_key_path = private_key
  config.ssh.insert_key = false

  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.provision "shell",
                      inline: "sudo passwd --lock automation || true"

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.gui = false
    vmware.vmx["ethernet0.virtualDev"] = "vmxnet3"
    vmware.vmx["ethernet0.pcislotnumber"] = "160"
    vmware.vmx["ethernet1.pcislotnumber"] = "192"
    vmware.vmx["mks.enable3d"] = "FALSE"
  end

  config.vm.define "automation-controller", primary: true do |controller|
    controller.vm.hostname = "automation-controller"
    controller.vm.network "private_network", ip: local_config.fetch("controller_ip")

    controller.vm.provider "vmware_desktop" do |vmware|
      vmware.vmx["displayName"] = "AUTOMATION-CONTROLLER"
      vmware.cpus = 2
      vmware.memory = 4096
    end
  end

  config.vm.define "srv01-validation" do |platform|
    platform.vm.hostname = "srv01-validation"
    platform.vm.network "private_network", ip: local_config.fetch("platform_ip")

    platform.vm.provider "vmware_desktop" do |vmware|
      vmware.vmx["displayName"] = "SRV01-VALIDATION"
      vmware.cpus = 4
      vmware.memory = 8192
    end
  end

  if local_config.key?("recovery_ip")
    config.vm.define "srv01-recovery" do |recovery|
      recovery.vm.hostname = "srv01-recovery"
      recovery.vm.network "private_network", ip: local_config.fetch("recovery_ip")
      recovery.vm.network "forwarded_port",
                          guest: 8443,
                          host: 9443,
                          host_ip: "127.0.0.1",
                          auto_correct: true,
                          id: "recovery-https"

      recovery.vm.provider "vmware_desktop" do |vmware|
        vmware.vmx["displayName"] = "SRV01-RECOVERY"
        vmware.cpus = 4
        vmware.memory = 8192
      end
    end
  end
end
