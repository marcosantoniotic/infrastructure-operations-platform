# Public example only. Never commit real values.
BASE_DOMAIN=example.com
LAN_ADDRESS=<LAN_IP>
PRODUCTION_ADDRESS=<PRODUCTION_IP>
UDM_ADDRESS=<UDM_IP>
MIKROTIK_ADDRESS=<MIKROTIK_IP>

# References to externally managed secrets.
CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token
GRAFANA_ADMIN_PASSWORD_FILE=/run/secrets/grafana_admin_password
MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
ZABBIX_API_TOKEN_FILE=/run/secrets/zabbix_api_token
