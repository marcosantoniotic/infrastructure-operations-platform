name: cloudflare-tunnel

services:
  cloudflared:
    image: {{ cloudflare_tunnel_image }}
    container_name: {{ cloudflare_tunnel_container_name }}
    user: "65532:65532"
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 0.0.0.0:{{ cloudflare_tunnel_metrics_port }}
      - run
      - --token-file
      - /run/secrets/tunnel_token
    volumes:
      - ./secrets/tunnel_token:/run/secrets/tunnel_token:ro,Z
      - ./certs/origin-ca.crt:/etc/cloudflared/origin-ca.crt:ro,Z
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    networks:
      - proxy

networks:
  proxy:
    name: {{ cloudflare_tunnel_proxy_network }}
    external: true
