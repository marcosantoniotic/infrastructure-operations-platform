#!/usr/bin/env python3
"""Reconcile tagged NetBox devices with Zabbix hosts."""

from __future__ import annotations

import argparse
import json
import logging
import os
import re
import sys
from pathlib import Path
from typing import Any

def setup_netbox() -> None:
    global Device, VirtualMachine, ContentType, CustomField, CustomFieldChoiceSet
    sys.path.insert(0, "/opt/netbox/netbox")
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "netbox.settings")
    import django
    django.setup()
    from dcim.models import Device
    from virtualization.models import VirtualMachine
    from django.contrib.contenttypes.models import ContentType
    from extras.models import CustomField, CustomFieldChoiceSet

LOG = logging.getLogger("netbox-zabbix-sync")
MANAGED_TAG_KEYS = {
    "source", "netbox_id", "netbox_status", "netbox_site", "netbox_role", "netbox_platform",
    "netbox_object_type",
    "netbox_monitoring_profile",
    "netbox_monitoring_source",
    "netbox_profile_reconciliation",
    "netbox_technical_group",
}


def load_technical_groups(profiles, field_config):
    enabled = os.environ.get("NETBOX_TECHNICAL_GROUPS_ENABLED", "false").lower()
    if enabled not in {"true", "false"}:
        raise RuntimeError("Technical group switch must be true or false")
    config = unique_json(os.environ.get("NETBOX_TECHNICAL_GROUPS", "{}"))
    if not isinstance(config, dict):
        raise RuntimeError("Technical groups require a profile/name map")
    if enabled == "false":
        if config:
            raise RuntimeError("Technical group map requires explicit opt-in")
        return {}
    if not profiles or field_config is None or set(config) != set(profiles):
        raise RuntimeError("Technical groups require complete explicit custom-field profiles")
    if any(not valid_name(v, 200) or v != v.strip() for v in config.values()):
        raise RuntimeError("Invalid technical group name")
    if len(set(config.values())) != len(config) or set(config.values()) & {p["group"] for p in profiles.values()}:
        raise RuntimeError("Technical groups must be distinct from profile groups")
    return config


def technical_group_plan(host, profile, catalogue, base_groups=None):
    """Replace only the previous group proven owned by our per-host marker."""
    host = host or {}
    markers = [t.get("value", "") for t in host.get("tags", []) if t.get("tag") == "netbox_technical_group"]
    if not catalogue:
        if markers:
            raise RuntimeError("Refusing removal of installed technical-group protection")
        return None
    if profile not in catalogue or len(markers) > 1:
        raise RuntimeError("Invalid technical-group profile or duplicate ownership marker")
    ids = {str(v) for v in catalogue.values()}
    if len(ids) != len(catalogue) or any(not v.isdigit() or int(v) < 1 for v in ids):
        raise RuntimeError("Invalid or duplicate technical-group identity")
    current = {str(g["groupid"]) for g in host.get("hostgroups", [])}
    previous = None
    if markers:
        parts = markers[0].split(":")
        if len(parts) != 3 or parts[0] != "v1" or parts[1] not in catalogue:
            raise RuntimeError("Invalid technical-group ownership marker")
        previous = parts[2]
        if previous != str(catalogue[parts[1]]) or previous not in current:
            raise RuntimeError("Technical-group remap or missing owned membership requires explicit recovery")
    if current & ids != ({previous} if previous else set()):
        raise RuntimeError("Unowned technical-group membership; refusing takeover")
    desired = {str(g["groupid"]) for g in base_groups} if base_groups is not None else set(current)
    if previous:
        desired.discard(previous)
    target = str(catalogue[profile])
    desired.add(target)
    if desired & ids != {target}:
        raise RuntimeError("Technical-group plan would mix profiles")
    marker = "v1:" + profile + ":" + target
    if len(marker) > 255:
        raise RuntimeError("Technical-group marker exceeds tag size")
    return {"groups": [{"groupid": v} for v in sorted(desired)], "marker": marker,
            "changed": desired != current or markers != [marker]}


def load_profile_transitions(profiles, field_config):
    """Additive-only, explicit edges. Never unlink/clear a template or guess readiness."""
    edges = unique_json(os.environ.get("NETBOX_PROFILE_TRANSITIONS", "[]"))
    ready = unique_json(os.environ.get("NETBOX_PROFILE_READY", "{}"))
    if not isinstance(edges, list) or not isinstance(ready, dict):
        raise RuntimeError("Invalid profile transition policy")
    if (edges or ready) and (not profiles or field_config is None):
        raise RuntimeError("Profile transitions require explicit custom-field selection")
    pairs = set()
    for edge in edges:
        if (not isinstance(edge, dict) or set(edge) != {"from", "to"}
                or not all(isinstance(edge[k], str) and edge[k] in profiles for k in ("from", "to"))
                or edge["from"] == edge["to"]):
            raise RuntimeError("Invalid profile transition edge")
        pair = (edge["from"], edge["to"])
        if pair in pairs:
            raise RuntimeError("Duplicate profile transition edge")
        pairs.add(pair)
    for key, value in ready.items():
        if (not isinstance(key, str) or not re.fullmatch(r"(?:dcim\.device|virtualization\.virtualmachine):[1-9][0-9]*", key)
                or not isinstance(value, dict) or set(value) != {"profile", "hostid"}
                or not isinstance(value["profile"], str) or value["profile"] not in profiles or not isinstance(value["hostid"], str)
                or not re.fullmatch(r"[1-9][0-9]*", value["hostid"])):
            raise RuntimeError("Invalid per-host profile readiness attestation")
    if ready and not pairs:
        raise RuntimeError("Readiness requires an enabled transition policy")
    return pairs, ready


class ProfilePending(RuntimeError):
    """Known, safe per-object refusal; not a fatal ownership/schema error."""


def profile_fingerprint(host):
    return (host["hostid"], host["host"], host["name"], str(host["status"]), str(host.get("tls_accept")),
            sorted(str(g["groupid"]) for g in host.get("hostgroups", [])),
            sorted(str(t["templateid"]) for t in host.get("parentTemplates", [])),
            normalized(host.get("tags", [])),
            sorted(tuple(str(i.get(k, "")) for k in ("interfaceid", "type", "main", "ip", "dns", "port", "useip"))
                   for i in host.get("interfaces", [])))


def additive_profile_update(api, host, obj, old, new, profiles, edges, ready, template_keys, agent_profiles):
    if (old, new) not in edges:
        raise ProfilePending("transition-not-authorized")
    previous, desired = profiles.get(old), profiles[new]
    if previous is None:
        raise ProfilePending("previous-profile-unknown")
    if desired.get("passive_agent"):
        raise ProfilePending("passive-agent-transition-not-supported")
    current_groups = {str(g["groupid"]) for g in host.get("hostgroups", [])}
    current_templates = {str(t["templateid"]) for t in host.get("parentTemplates", [])}
    old_templates, new_templates = set(previous["templateids"]), set(desired["templateids"])
    if previous["groupid"] not in current_groups or not old_templates.issubset(current_templates):
        raise ProfilePending("previous-profile-drift")
    if not old_templates.issubset(new_templates):
        raise ProfilePending("template-removal-requires-reviewed-migration")
    if str(obj.custom_field_data.get(os.environ["NETBOX_ZABBIX_HOSTID_FIELD"]) or "") != str(host["hostid"]):
        raise ProfilePending("missing-confirmed-host-link")
    if new in agent_profiles:
        attestation = ready.get(":".join(identity(obj)))
        if attestation != {"profile": new, "hostid": str(host["hostid"])}:
            raise ProfilePending("agent-readiness-not-attested")
        # Active agent transport may accept PSK/certificates, never plaintext.
        if str(host.get("tls_accept")) not in {"2", "4", "6"}:
            raise ProfilePending("secure-active-agent-channel-required")
    added = new_templates - current_templates
    if added:
        items = api.call("item.get", {"output": ["key_"], "hostids": [host["hostid"]]})
        rules = api.call("discoveryrule.get", {"output": ["key_"], "hostids": [host["hostid"]],
                                             "selectItems": ["key_"]})
        existing_keys = {i["key_"] for i in items + rules + [i for r in rules for i in r.get("items", [])]}
        if existing_keys & {key for tid in added for key in template_keys[tid]}:
            raise ProfilePending("existing-item-or-discovery-key-collision")
    # Remove ONLY the previous managed group. Extra groups/templates stay linked.
    groups = (current_groups - {previous["groupid"]}) | {desired["groupid"]}
    return {"groups": [{"groupid": g} for g in sorted(groups)],
            "templates": [{"templateid": t} for t in sorted(current_templates | new_templates)]}


def unique_json(raw: str) -> Any:
    def pairs(values):
        result = {}
        for key, value in values:
            if key in result:
                raise RuntimeError("Duplicate monitoring configuration JSON key")
            result[key] = value
        return result
    try:
        return json.loads(raw, object_pairs_hook=pairs)
    except (ValueError, TypeError) as exc:
        raise RuntimeError("Invalid monitoring configuration JSON") from exc


def template_names(profile: dict[str, Any]) -> list[str]:
    return [profile["template"]] if "template" in profile else profile["templates"]


def valid_name(value: Any, maximum: int = 255) -> bool:
    return isinstance(value, str) and bool(value.strip()) and len(value) <= maximum and not re.search(r"[\x00-\x1f\x7f$]", value)


def load_platform_mapping() -> tuple[dict[str, str], dict[str, dict[str, Any]]]:
    """Exact inventory slugs only; never guess an OS or fall back to Linux."""
    enabled = os.environ.get("NETBOX_PLATFORM_MAPPING_ENABLED", "false")
    if enabled not in {"true", "false"}:
        raise RuntimeError("NETBOX_PLATFORM_MAPPING_ENABLED must be true or false")

    mapping = unique_json(os.environ.get("NETBOX_PLATFORM_MAP", "{}"))
    profiles = unique_json(os.environ.get("NETBOX_PLATFORM_PROFILES", "{}"))
    if not isinstance(mapping, dict) or not isinstance(profiles, dict):
        raise RuntimeError("Platform mapping and profiles must be JSON objects")
    if enabled == "false":
        if mapping or profiles:
            raise RuntimeError("Platform mapping data requires explicit opt-in")
        return {}, {}
    if not profiles or (os.environ.get("NETBOX_PROFILE_SOURCE", "platform") == "platform" and not mapping):
        raise RuntimeError("Enabled platform mapping requires explicit slugs and profiles")
    slug = re.compile(r"[a-z0-9][a-z0-9_-]{0,99}")
    for name, profile in profiles.items():
        if (not isinstance(name, str) or not slug.fullmatch(name) or not isinstance(profile, dict)
                or set(profile) not in ({"group", "template"}, {"group", "templates"})):
            raise RuntimeError("Invalid monitoring profile schema")
        names = template_names(profile)
        if (not isinstance(names, list) or not 1 <= len(names) <= 16
                or not valid_name(profile["group"]) or any(not valid_name(v) for v in names)):
            raise RuntimeError("Invalid monitoring profile group/template name")
        if len(names) != len(set(names)):
            raise RuntimeError("Duplicate template in monitoring profile")
    for platform, profile in mapping.items():
        if not isinstance(platform, str) or not slug.fullmatch(platform) or not isinstance(profile, str) or profile not in profiles:
            raise RuntimeError("Platform mapping references an invalid slug or unknown profile")
    return mapping, profiles


def load_field_selection(profiles: dict[str, Any]) -> dict[str, Any] | None:
    source = os.environ.get("NETBOX_PROFILE_SOURCE", "platform")
    if source not in {"platform", "custom-field"}:
        raise RuntimeError("NETBOX_PROFILE_SOURCE must be platform or custom-field")
    values = unique_json(os.environ.get("NETBOX_PROFILE_VALUES", "{}"))
    labels = unique_json(os.environ.get("NETBOX_PROFILE_LABELS", "{}"))
    if not isinstance(values, dict) or not isinstance(labels, dict):
        raise RuntimeError("Custom-field value maps and labels must be JSON objects")
    if source == "platform":
        if values or labels:
            raise RuntimeError("Custom-field policy requires explicit custom-field source")
        return None
    if not profiles or not isinstance(values, dict) or not values:
        raise RuntimeError("Custom-field selection requires enabled mapping and explicit values")
    slug = re.compile(r"[a-z0-9][a-z0-9_-]{0,99}")
    for value, profile in values.items():
        if not isinstance(value, str) or not slug.fullmatch(value) or not isinstance(profile, str) or profile not in profiles:
            raise RuntimeError("Custom-field value references an invalid or unknown monitoring profile")
    if not isinstance(labels, dict) or set(labels) != set(values) or any(not valid_name(v, 100) for v in labels.values()):
        raise RuntimeError("Custom-field choices must match the configured value map")
    name = os.environ.get("NETBOX_PROFILE_FIELD", "monitoring_profile")
    choice_set = os.environ.get("NETBOX_PROFILE_CHOICE_SET", "iop-monitoring-profiles")
    label = os.environ.get("NETBOX_PROFILE_FIELD_LABEL", "Perfil de monitoramento")
    if (not re.fullmatch(r"[a-z][a-z0-9_]{0,49}", name) or "__" in name
            or name == os.environ.get("NETBOX_ZABBIX_HOSTID_FIELD", "zabbix_hostid")):
        raise RuntimeError("Invalid or conflicting monitoring custom field name")
    if not slug.fullmatch(choice_set) or not valid_name(label, 50):
        raise RuntimeError("Invalid custom field choice set or label")
    return {"name": name, "choice_set": choice_set, "label": label, "values": values, "labels": labels}


def validate_profile_field(config: dict[str, Any], include_vms: bool) -> Any:
    field = CustomField.objects.filter(name=config["name"]).first()
    if field is None or field.type != "select" or not field.choice_set:
        raise RuntimeError("Monitoring custom field must be prepared as a single selection before synchronization")
    choices = list(field.choice_set.choices)
    if (len(choices) != len(config["labels"]) or dict(choices) != config["labels"]
            or field.choice_set.name != config["choice_set"] or field.default is not None
            or field.label != config["label"]):
        raise RuntimeError("Monitoring custom field choices/default differ; explicit schema migration required")
    if field.ui_visible != "always" or field.ui_editable != "yes":
        raise RuntimeError("Monitoring custom field must be visible and editable")
    for model in ([Device, VirtualMachine] if include_vms else [Device]):
        ct = ContentType.objects.get_for_model(model)
        if not field.object_types.filter(pk=ct.pk).exists():
            raise RuntimeError("Monitoring custom field is not assigned to a selected object type")
    return field


def prepare_profile_field(config: dict[str, Any]) -> dict[str, Any]:
    """Explicit schema operation only; never seed objects or contact Zabbix."""
    from django.db import transaction
    with transaction.atomic():
        field = CustomField.objects.select_for_update().filter(name=config["name"]).first()
        choices = CustomFieldChoiceSet.objects.select_for_update().filter(name=config["choice_set"]).first()
        if field is not None:
            validate_profile_field(config, True)
            return {"created": False, "field_id": field.pk, "choice_set_id": field.choice_set_id}
        if choices is not None and (choices.base_choices or dict(choices.choices) != config["labels"]
                                    or len(choices.choices) != len(config["labels"])):
            raise RuntimeError("Existing choice set differs; refusing to overwrite it")
        if choices is None:
            choices = CustomFieldChoiceSet(name=config["choice_set"], description="IOP monitoring profile choices", extra_choices=list(config["labels"].items()))
            choices.full_clean(); choices.save()
        field = CustomField(name=config["name"], label=config["label"], type="select", choice_set=choices,
                            description="Explicit monitoring profile; blank blocks selected objects. No OS inference.", required=False)
        field.full_clean(); field.save()
        field.object_types.add(*[ContentType.objects.get_for_model(model) for model in [Device, VirtualMachine]])
        validate_profile_field(config, True)
        return {"created": True, "field_id": field.pk, "choice_set_id": choices.pk}


def resolve_monitoring_profile(obj: Any, mapping: dict[str, str]) -> str:
    platform = obj.platform.slug if obj.platform else ""
    if platform not in mapping:
        raise RuntimeError(f"Unmapped or missing NetBox platform for {host_name(obj)}; no writes applied")
    return mapping[platform]


def primary_agent_interface(host: dict[str, Any]) -> dict[str, Any] | None:
    interfaces = [i for i in host.get("interfaces", [])
                  if str(i.get("type")) == "1" and str(i.get("main")) == "1"]
    if len(interfaces) > 1:
        raise RuntimeError("Ambiguous primary address interface; refusing reconciliation")
    return interfaces[0] if interfaces else None


def object_type(obj: Any) -> str:
    return obj._meta.label_lower


def identity(obj: Any) -> tuple[str, str]:
    return object_type(obj), str(obj.pk)


def host_name(obj: Any) -> str:
    # Stable namespace prevents VM/device ID and name collisions and survives VM renames.
    return f"netbox-vm-{obj.pk}" if object_type(obj) == "virtualization.virtualmachine" else obj.name


def host_identity(host: dict[str, Any]) -> tuple[str, str] | None:
    tags: dict[str, str] = {}
    for tag in host.get("tags", []):
        key = tag.get("tag", "")
        if key in MANAGED_TAG_KEYS and key in tags:
            raise RuntimeError("Duplicate ownership tags on Zabbix host")
        tags[key] = tag.get("value", "")
    if tags.get("source") != "netbox" or not tags.get("netbox_id"):
        return None
    # Pre-VM deployments have untyped device IDs; preserve their ownership.
    kind = tags.get("netbox_object_type", "dcim.device")
    if kind not in {"dcim.device", "virtualization.virtualmachine"}:
        raise RuntimeError("Unsupported NetBox ownership type; refusing reconciliation")
    return kind, tags["netbox_id"]


class ZabbixAPI:
    def __init__(self, url: str, token: str) -> None:
        self.url = url
        self.token = token
        self.request_id = 0

    def call(self, method: str, params: dict[str, Any]) -> Any:
        import requests
        self.request_id += 1
        response = requests.post(
            self.url,
            headers={"Authorization": f"Bearer {self.token}"},
            json={"jsonrpc": "2.0", "method": method, "params": params, "id": self.request_id},
            timeout=30,
        )
        response.raise_for_status()
        payload = response.json()
        if "error" in payload:
            error = payload["error"]
            raise RuntimeError(f"{method}: {error.get('message')}: {error.get('data')}")
        return payload["result"]


def unique_id(api: ZabbixAPI, method: str, key: str, value: str) -> str:
    result = api.call(method, {"output": [key, "name"], "filter": {"name": [value]}})
    if len(result) != 1:
        raise RuntimeError(f"Expected exactly one Zabbix object for {value!r}; found {len(result)}")
    return str(result[0][key])


def primary_ip(device: Device) -> str | None:
    address = device.primary_ip4 or device.primary_ip6
    return str(address.address.ip) if address else None


def managed_tags(device: Device, profile: str | None = None, source: str | None = None) -> list[dict[str, str]]:
    result = [
        {"tag": "source", "value": "netbox"},
        {"tag": "netbox_id", "value": str(device.pk)},
        {"tag": "netbox_object_type", "value": object_type(device)},
        {"tag": "netbox_status", "value": str(device.status)},
        {"tag": "netbox_site", "value": device.site.slug if device.site else ""},
        {"tag": "netbox_role", "value": device.role.slug if device.role else ""},
        {"tag": "netbox_platform", "value": device.platform.slug if device.platform else ""},
    ]
    if profile is not None:
        result.append({"tag": "netbox_monitoring_profile", "value": profile})
    if source is not None:
        result.append({"tag": "netbox_monitoring_source", "value": source})
    return result


def normalized(tags: list[dict[str, Any]]) -> list[tuple[str, str]]:
    return sorted((str(tag.get("tag", "")), str(tag.get("value", ""))) for tag in tags)


def ensure_custom_field(name: str, apply: bool, include_vms: bool = False) -> None:
    field = CustomField.objects.filter(name=name).first()
    if field is None:
        if not apply:
            raise RuntimeError(f"NetBox custom field is missing: {name}; run once with --apply")
        field = CustomField.objects.create(name=name, label="Zabbix Host ID", type="text", required=False)
        LOG.info("CREATE-CUSTOM-FIELD field=%s", name)
    if field.type != "text":
        raise RuntimeError("Zabbix Host ID custom field must be text")
    for model in ([Device, VirtualMachine] if include_vms else [Device]):
        content_type = ContentType.objects.get_for_model(model)
        if not field.object_types.filter(pk=content_type.pk).exists():
            if not apply:
                LOG.info("PENDING-CUSTOM-FIELD field=%s object=%s", name, model._meta.label_lower)
            else:
                field.object_types.add(content_type)
                LOG.info("ASSIGN-CUSTOM-FIELD field=%s object=%s", name, model._meta.label_lower)


def set_hostid(device: Device, field_name: str, hostid: str, apply: bool) -> bool:
    if str(device.custom_field_data.get(field_name) or "") == hostid:
        return False
    if apply:
        data = dict(device.custom_field_data)
        data[field_name] = hostid
        device.custom_field_data = data
        device.save(update_fields=["custom_field_data"])
    return True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--validate-platform-config", action="store_true",
                        help="Validate only profile JSON; no Django, credentials, network or writes")
    parser.add_argument("--prepare-monitoring-field", action="store_true",
                        help="Explicitly prepare selection field/choices only; no object values or Zabbix operations")
    args = parser.parse_args()
    if sum([args.apply, args.validate_platform_config, args.prepare_monitoring_field]) > 1:
        parser.error("--apply, --validate-platform-config and --prepare-monitoring-field are mutually exclusive")
    platform_map, profile_config = load_platform_mapping()
    field_config = load_field_selection(profile_config)
    transitions, readiness = load_profile_transitions(profile_config, field_config)
    technical_config = load_technical_groups(profile_config, field_config)
    if args.validate_platform_config:
        return 0
    setup_netbox()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(asctime)s %(levelname)s %(message)s")
    if args.prepare_monitoring_field:
        if field_config is None:
            parser.error("Field preparation requires custom-field profile source")
        print(json.dumps(prepare_profile_field(field_config)))
        return 0

    token = Path(os.environ["ZABBIX_API_TOKEN_FILE"]).read_text(encoding="utf-8").strip()
    if not token:
        raise RuntimeError("Zabbix API token file is empty")
    api = ZabbixAPI(os.environ["ZABBIX_URL"], token)
    groupid = unique_id(api, "hostgroup.get", "groupid", os.environ["ZABBIX_GROUP"])
    templateid = unique_id(api, "template.get", "templateid", os.environ["ZABBIX_TEMPLATE"])
    tag_slug = os.environ["NETBOX_TAG_SLUG"]
    field_name = os.environ["NETBOX_ZABBIX_HOSTID_FIELD"]
    include_vms_raw = os.environ.get("NETBOX_INCLUDE_VMS", "false").lower()
    if include_vms_raw not in {"true", "false"}:
        raise RuntimeError("NETBOX_INCLUDE_VMS must be true or false")
    include_vms = include_vms_raw == "true"
    if field_config is not None:
        validate_profile_field(field_config, include_vms)
    sites = {s.strip() for s in os.environ.get("NETBOX_SITE_SLUGS", "").split(",") if s.strip()}
    vm_groupid = vm_templateid = None
    if include_vms:
        if not os.environ.get("NETBOX_VM_TEMPLATE"):
            raise RuntimeError("An explicit VM template is required")
        vm_groupid = unique_id(api, "hostgroup.get", "groupid", os.environ["NETBOX_VM_GROUP"])
        vm_templateid = unique_id(api, "template.get", "templateid", os.environ["NETBOX_VM_TEMPLATE"])

    profiles = {name: {
        "groupid": unique_id(api, "hostgroup.get", "groupid", config["group"]),
        "templateids": [unique_id(api, "template.get", "templateid", name) for name in template_names(config)],
    } for name, config in profile_config.items()}
    technical_ids = {name: unique_id(api, "hostgroup.get", "groupid", group)
                     for name, group in technical_config.items()}
    base_ids = {str(groupid), str(vm_groupid)} | {str(p["groupid"]) for p in profiles.values()}
    if len(set(technical_ids.values())) != len(technical_ids) or set(map(str, technical_ids.values())) & base_ids:
        raise RuntimeError("Technical group catalogue overlaps base groups")
    # This implementation manages the default address interface, not SNMP,
    # IPMI or JMX transports. Resolve incompatibilities for ALL profiles before
    # creating even the first host. No credential/interface auto-conversion.
    template_keys = {}
    agent_profiles = set()
    for profile_name, profile in profiles.items():
        if len(profile["templateids"]) != len(set(profile["templateids"])):
            raise RuntimeError("Duplicate resolved template identity in monitoring profile")
        keys = {}
        for tid in profile["templateids"]:
            items = api.call("item.get", {"output": ["type", "key_", "itemid"], "templateids": [tid]})
            rules = api.call("discoveryrule.get", {"output": ["type", "key_", "itemid"], "selectItems": ["type", "key_", "itemid"],
                                                  "templateids": [tid]})
            interface_items = items + rules + [i for rule in rules for i in rule.get("items", [])]
            template_keys[tid] = {i["key_"] for i in interface_items if i.get("key_")}
            if any(str(i.get("type")) == "7" for i in interface_items):
                agent_profiles.add(profile_name)
            if any(str(i.get("type")) == "0" for i in interface_items):
                profile["passive_agent"] = True
            if not items or any(str(i["type"]) in {"1", "4", "6", "12", "16", "17", "20"} for i in interface_items):
                raise RuntimeError("Mapped template requires an unsupported interface; only agent/ICMP profiles are supported")
            for item in interface_items:
                key = item.get("key_")
                if len(profile["templateids"]) > 1 and (not key or not item.get("itemid")):
                    raise RuntimeError("Multi-template preflight requires item keys and identities")
                if key and key in keys and keys[key] != str(item.get("itemid")):
                    raise RuntimeError("Mapped templates have duplicate item/discovery keys; explicit review required")
                if key:
                    keys[key] = str(item.get("itemid"))

    def target(obj):
        if profiles:
            if field_config is None:
                name = resolve_monitoring_profile(obj, platform_map)
            else:
                value = obj.custom_field_data.get(field_config["name"])
                if not isinstance(value, str) or value not in field_config["values"]:
                    raise RuntimeError(f"Missing or unmapped monitoring custom field for {host_name(obj)}; no writes applied")
                name = field_config["values"][value]
            return profiles[name]["groupid"], profiles[name]["templateids"], name
        if object_type(obj) == "virtualization.virtualmachine":
            return vm_groupid, [vm_templateid], None
        return groupid, [templateid], None

    hosts = api.call("host.get", {
        "output": ["hostid", "host", "name", "status", "tls_accept"],
        "selectTags": "extend", "selectInterfaces": "extend",
        "selectHostGroups": ["groupid"], "selectParentTemplates": ["templateid"],
    })
    managed = {}
    for host in hosts:
        key = host_identity(host)
        if key is None:
            continue
        if key in managed:
            raise RuntimeError("Multiple Zabbix hosts claim the same NetBox object")
        managed[key] = host
    if any(t.get("tag") == "netbox_profile_reconciliation" and
           (t.get("value") != "additive-v1" or not transitions)
           for host in managed.values() for t in host.get("tags", [])):
        raise RuntimeError("Refusing to remove installed profile reconciliation protection")
    if not profiles and any(t.get("tag") == "netbox_monitoring_profile" for h in managed.values() for t in h.get("tags", [])):
        raise RuntimeError("Refusing to silently remove installed platform mapping")
    by_name = {host["host"]: host for host in hosts}
    if not technical_ids and any(t.get("tag") == "netbox_technical_group" for h in managed.values() for t in h.get("tags", [])):
        raise RuntimeError("Refusing removal of installed technical-group protection")
    desired_ids: set[tuple[str, str]] = set()
    changes = 0

    devices = list(Device.objects.filter(tags__slug=tag_slug).select_related(
        "site", "role", "platform", "primary_ip4", "primary_ip6"
    ).distinct().order_by("name"))
    vms = list(VirtualMachine.objects.filter(tags__slug=tag_slug).select_related(
        "site", "role", "platform", "primary_ip4", "primary_ip6"
    ).distinct().order_by("name")) if include_vms else []
    objects = [obj for obj in devices + vms if not sites or (obj.site and obj.site.slug in sites)]
    # Preflight the entire set before any API or metadata write: no partial collision takeover.
    planned_names: dict[str, tuple[str, str]] = {}
    planned_profiles = {}
    profile_updates = {}
    technical_updates = {}
    pending = {}
    for obj in objects:
        try:
            expected_group, expected_template, profile_name = target(obj)
        except RuntimeError:
            if not transitions:
                raise
            pending[identity(obj)] = "invalid-monitoring-profile"
            continue
        planned_profiles[identity(obj)] = (expected_group, expected_template, profile_name)
        if profile_name is not None:
            LOG.debug("PROFILE host=%s platform=%s profile=%s group=%s template=%s", host_name(obj),
                      obj.platform.slug if obj.platform else "", profile_name, profile_config[profile_name]["group"],
                      ", ".join(template_names(profile_config[profile_name])))
        name = host_name(obj)
        if name in planned_names and planned_names[name] != identity(obj):
            raise RuntimeError(f"Planned Zabbix host name collision: {name}")
        planned_names[name] = identity(obj)
        existing = managed.get(identity(obj))
        collision = by_name.get(host_name(obj))
        if collision and collision is not existing:
            raise RuntimeError(f"Zabbix host name collision: {host_name(obj)}")
        stored = str(obj.custom_field_data.get(field_name) or "")
        if stored and (not existing or stored != str(existing["hostid"])):
            raise RuntimeError(f"Conflicting stored Zabbix ID for {host_name(obj)}")
        if existing:
            old_profile = next((t.get("value", "") for t in existing.get("tags", [])
                                if t.get("tag") == "netbox_monitoring_profile"), None)
            marker = next((t.get("value", "") for t in existing.get("tags", [])
                           if t.get("tag") == "netbox_profile_reconciliation"), None)
            if marker is not None and (marker != "additive-v1" or not transitions):
                raise RuntimeError("Refusing to remove installed profile reconciliation protection")
            try:
                if old_profile is not None and old_profile != profile_name and transitions:
                    profile_updates[identity(obj)] = additive_profile_update(
                        api, existing, obj, old_profile, profile_name, profiles, transitions,
                        readiness, template_keys, agent_profiles)
                else:
                    if str(expected_group) not in {str(g["groupid"]) for g in existing.get("hostgroups", [])}:
                        raise ProfilePending("Existing managed host is outside the configured group")
                    if not set(expected_template).issubset({str(t["templateid"]) for t in existing.get("parentTemplates", [])}):
                        raise ProfilePending("Existing host template differs; an explicit migration is required")
                    if old_profile is not None and old_profile != profile_name:
                        raise ProfilePending("Existing monitoring profile differs; an explicit migration is required")
            except ProfilePending as exc:
                if not transitions:
                    raise
                pending[identity(obj)] = str(exc)
            interface = primary_agent_interface(existing)
            if profiles and (interface is None or str(interface.get("port")) != "10050"
                             or str(interface.get("useip")) != "1" or interface.get("dns", "") != ""):
                raise RuntimeError("Existing profile address interface differs; explicit migration required")
    # Preflight technical memberships before any object write.
    for obj in objects:
        key = identity(obj)
        if key in pending:
            continue
        existing = managed.get(key)
        base = profile_updates.get(key, {}).get("groups")
        if existing is None:
            base = [{"groupid": planned_profiles[key][0]}]
        technical_updates[key] = technical_group_plan(existing, planned_profiles[key][2], technical_ids, base)

    def in_scope(host: dict[str, Any], key: tuple[str, str]) -> bool:
        tags = {t["tag"]: t.get("value", "") for t in host.get("tags", [])}
        if sites and tags.get("netbox_site") not in sites:
            return False
        old_profile = tags.get("netbox_monitoring_profile")
        if old_profile is not None:
            if old_profile not in profiles:
                raise RuntimeError("Managed host references an unknown monitoring profile")
            group = profiles[old_profile]["groupid"]
        else:
            group = vm_groupid if key[0] == "virtualization.virtualmachine" else groupid
        return str(group) in {
            str(g["groupid"]) for g in host.get("hostgroups", [])}
    if not include_vms and any(k[0] == "virtualization.virtualmachine" for k in managed):
        raise RuntimeError("Refusing to silently disable previously managed VM synchronization")
    # Resolve orphan scope BEFORE any write too (including unknown old profiles).
    scoped_managed = {key for key, host in managed.items() if in_scope(host, key)}
    source_marker = "custom-field:" + field_config["name"] if field_config else None
    for key in scoped_managed:
        old_source = next((t.get("value", "") for t in managed[key].get("tags", [])
                           if t.get("tag") == "netbox_monitoring_source"), None)
        if old_source is not None and old_source != source_marker:
            raise RuntimeError("Refusing to remove or change installed monitoring custom-field source")
    ensure_custom_field(field_name, args.apply, include_vms)
    # Pending objects remain desired: never classify a refusal as an orphan.
    desired_ids.update(identity(obj) for obj in objects)
    for device in objects:
        netbox_id = identity(device)
        if netbox_id in pending:
            LOG.warning("PROFILE-PENDING object=%s reason=%s", ":".join(netbox_id), pending[netbox_id])
            continue
        target_group, target_template, profile_name = planned_profiles[netbox_id]
        technical_name = host_name(device)
        desired_ids.add(netbox_id)
        ip = primary_ip(device)
        existing = managed.get(netbox_id)
        if not ip:
            LOG.warning("SKIP device=%s reason=no-primary-ip", device.name)
            if existing and existing["status"] != "1":
                changes += 1
                if args.apply:
                    api.call("host.update", {"hostid": existing["hostid"], "status": 1})
            continue

        tags = managed_tags(device, profile_name, source_marker)
        technical = technical_updates.get(netbox_id)
        if technical:
            tags.append({"tag": "netbox_technical_group", "value": technical["marker"]})
        marker = ("additive-v1" if netbox_id in profile_updates else
                  next((t["value"] for t in (existing or {}).get("tags", [])
                        if t["tag"] == "netbox_profile_reconciliation"), None))
        if marker:
            tags.append({"tag": "netbox_profile_reconciliation", "value": marker})
        status = 0 if str(device.status) == "active" else 1
        if existing is None:
            changes += 1
            LOG.info("CREATE host=%s ip=%s", device.name, ip)
            if args.apply:
                result = api.call("host.create", {
                    "host": technical_name, "name": device.name, "status": status,
                    "groups": technical["groups"] if technical else [{"groupid": target_group}], "templates": [{"templateid": tid} for tid in target_template],
                    "interfaces": [{"type": 1, "main": 1, "useip": 1, "ip": ip, "dns": "", "port": "10050"}],
                    "tags": tags,
                })
                set_hostid(device, field_name, str(result["hostids"][0]), True)
            continue

        update: dict[str, Any] = {"hostid": existing["hostid"]}
        update.update(profile_updates.get(netbox_id, {}))
        if technical and {str(g["groupid"]) for g in technical["groups"]} != {str(g["groupid"]) for g in existing.get("hostgroups", [])}:
            update["groups"] = technical["groups"]
        if existing["host"] != technical_name or existing["name"] != device.name:
            update.update({"host": technical_name, "name": device.name})
        if int(existing["status"]) != status:
            update["status"] = status
        # host.get includes read-only fields (e.g. automatic in Zabbix 7.4).
        # Preserve unmanaged tag/value, not output-only metadata in update input.
        preserved = [{"tag": t["tag"], "value": t.get("value", "")}
                     for t in existing.get("tags", []) if t.get("tag") not in MANAGED_TAG_KEYS]
        merged = preserved + tags
        if normalized(existing.get("tags", [])) != normalized(merged):
            update["tags"] = merged
        interface = primary_agent_interface(existing)
        changed = len(update) > 1 or interface is None or interface.get("ip") != ip
        if changed:
            changes += 1
            LOG.info("UPDATE host=%s ip=%s", device.name, ip)
            if args.apply:
                if netbox_id in profile_updates or (technical and technical["changed"]):
                    fresh = api.call("host.get", {"hostids": [existing["hostid"]],
                        "output": ["hostid", "host", "name", "status", "tls_accept"],
                        "selectTags": "extend", "selectInterfaces": "extend",
                        "selectHostGroups": ["groupid"], "selectParentTemplates": ["templateid"]})
                    if len(fresh) != 1 or profile_fingerprint(fresh[0]) != profile_fingerprint(existing):
                        pending[netbox_id] = "concurrent-host-change"
                        LOG.warning("PROFILE-PENDING object=%s reason=concurrent-host-change", ":".join(netbox_id))
                        continue
                if len(update) > 1:
                    api.call("host.update", update)
                if interface is None:
                    api.call("hostinterface.create", {"hostid": existing["hostid"], "type": 1,
                             "main": 1, "useip": 1, "ip": ip, "dns": "", "port": "10050"})
                elif interface.get("ip") != ip:
                    api.call("hostinterface.update", {"interfaceid": interface["interfaceid"], "ip": ip,
                             "useip": 1, "dns": "", "port": "10050"})
        if set_hostid(device, field_name, str(existing["hostid"]), args.apply):
            changes += 1

    for netbox_id, host in managed.items():
        if netbox_id in scoped_managed and netbox_id not in desired_ids and host["status"] != "1":
            changes += 1
            LOG.info("DISABLE host=%s reason=tag-removed", host["host"])
            if args.apply:
                api.call("host.update", {"hostid": host["hostid"], "status": 1})

    LOG.info("Synchronization complete mode=%s devices=%d changes=%d vms=%d pending=%d",
             "apply" if args.apply else "dry-run", sum(k[0] == "dcim.device" for k in desired_ids),
             changes, sum(k[0] == "virtualization.virtualmachine" for k in desired_ids), len(pending))
    return 2 if pending else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception:
        LOG.exception("Synchronization failed")
        raise SystemExit(1)
