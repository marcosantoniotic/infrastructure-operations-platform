name: netbox-zabbix-sync

services:
  netbox-zabbix-sync:
    image: {{ netbox_zabbix_sync_image }}
    env_file:
      - {{ netbox_zabbix_sync_netbox_env_file }}
    environment:
      ZABBIX_URL: {{ netbox_zabbix_sync_zabbix_url }}
{% if iop_internal_api_tls_network | length > 0 %}
      SSL_CERT_FILE: /run/ca/internal-api-ca.crt
      REQUESTS_CA_BUNDLE: /run/ca/internal-api-ca.crt
{% endif %}
      ZABBIX_API_TOKEN_FILE: /run/secrets/zabbix_api_token
      ZABBIX_GROUP: {{ netbox_zabbix_sync_group | to_json }}
      ZABBIX_TEMPLATE: {{ netbox_zabbix_sync_template | to_json }}
      NETBOX_TAG_SLUG: {{ netbox_zabbix_sync_tag_slug | to_json }}
      NETBOX_ZABBIX_HOSTID_FIELD: {{ netbox_zabbix_sync_hostid_field | to_json }}
      NETBOX_INCLUDE_VMS: {{ ('true' if netbox_zabbix_sync_include_vms | bool else 'false') | to_json }}
      NETBOX_VM_GROUP: {{ netbox_zabbix_sync_vm_group | to_json }}
      NETBOX_VM_TEMPLATE: {{ netbox_zabbix_sync_vm_template | to_json }}
      NETBOX_SITE_SLUGS: {{ (netbox_zabbix_sync_site_slugs | join(',')) | to_json }}
{% if netbox_zabbix_sync_platform_mapping_enabled | bool %}
      NETBOX_PLATFORM_MAPPING_ENABLED: "true"
      NETBOX_PLATFORM_MAP: {{ netbox_zabbix_sync_platform_map | to_json | to_json }}
      NETBOX_PLATFORM_PROFILES: {{ netbox_zabbix_sync_platform_profiles | to_json | to_json }}
{% if netbox_zabbix_sync_technical_groups_enabled | default(false) | bool %}
      NETBOX_TECHNICAL_GROUPS_ENABLED: "true"
      NETBOX_TECHNICAL_GROUPS: {{ netbox_zabbix_sync_technical_groups | to_json | to_json }}
{% endif %}
{% if netbox_zabbix_sync_profile_source == 'custom-field' %}
      NETBOX_PROFILE_SOURCE: "custom-field"
      NETBOX_PROFILE_FIELD: {{ netbox_zabbix_sync_profile_field | to_json }}
      NETBOX_PROFILE_FIELD_LABEL: {{ netbox_zabbix_sync_profile_field_label | to_json }}
      NETBOX_PROFILE_CHOICE_SET: {{ netbox_zabbix_sync_profile_choice_set | to_json }}
      NETBOX_PROFILE_VALUES: {{ netbox_zabbix_sync_profile_values | to_json | to_json }}
      NETBOX_PROFILE_LABELS: {{ netbox_zabbix_sync_profile_labels | to_json | to_json }}
{% if netbox_zabbix_sync_profile_transitions | default([]) | length > 0 %}
      NETBOX_PROFILE_TRANSITIONS: {{ netbox_zabbix_sync_profile_transitions | to_json | to_json }}
      NETBOX_PROFILE_READY: {{ netbox_zabbix_sync_profile_ready | to_json | to_json }}
{% endif %}
{% endif %}
{% endif %}
    command:
      - /bin/sh
      - -c
      - >-
        while true; do
          /opt/netbox/venv/bin/python /usr/local/libexec/netbox-zabbix-sync.py --apply;
          sleep {{ netbox_zabbix_sync_interval }};
        done
    user: netbox:root
    restart: unless-stopped
    volumes:
      - ./netbox-zabbix-sync.py:/usr/local/libexec/netbox-zabbix-sync.py:ro,Z
      - ./secrets/zabbix_api_token:/run/secrets/zabbix_api_token:ro,Z
{% if iop_internal_api_tls_network | length > 0 %}
      - ./internal-api-ca.crt:/run/ca/internal-api-ca.crt:ro,Z
{% endif %}
    networks:
{% if iop_internal_api_tls_network | length > 0 %}
      - api-tls
{% endif %}
      - netbox
      - zabbix

networks:
{% if iop_internal_api_tls_network | length > 0 %}
  api-tls:
    name: {{ iop_internal_api_tls_network }}
    external: true
{% endif %}
  netbox:
    name: {{ netbox_zabbix_sync_netbox_network }}
    external: true
  zabbix:
    name: {{ netbox_zabbix_sync_zabbix_network }}
    external: true
