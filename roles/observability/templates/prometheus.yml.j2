---
global:
  scrape_interval: {{ observability_scrape_interval }}
  evaluation_interval: {{ observability_scrape_interval }}

rule_files:
  - /etc/prometheus/alerts.yml
{% if observability_alertmanager_enabled | bool %}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093
{% endif %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus:9090

  - job_name: node
    static_configs:
      - targets:
          - node-exporter:9100

  - job_name: containers
    static_configs:
      - targets:
          - cadvisor:8080

  - job_name: blackbox-exporter
    static_configs:
      - targets:
          - blackbox-exporter:9115
{% if observability_zabbix_glpi_bridge_enabled | bool %}

  - job_name: zabbix-glpi-bridge
    metrics_path: /metrics
    static_configs:
      - targets:
          - {{ observability_zabbix_glpi_bridge_target }}
{% endif %}
{% if observability_snmp_enabled | bool %}

  - job_name: network-snmp
    metrics_path: /snmp
    scrape_timeout: {{ observability_snmp_scrape_timeout }}
    params:
      auth:
        - {{ observability_snmp_auth_name }}
      module:
{% for module in observability_snmp_modules %}
        - {{ module }}
{% endfor %}
    static_configs:
{% for target in observability_snmp_targets %}
      - targets:
          - {{ target.address }}
        labels:
          device: {{ target.name }}
{% endfor %}
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: snmp-exporter:9116

  - job_name: snmp-exporter
    static_configs:
      - targets:
          - snmp-exporter:9116
{% endif %}
{% if observability_unifi_poller_enabled | bool %}

  - job_name: unifi-poller
    static_configs:
      - targets:
          - unifi-poller:9130
{% endif %}

  - job_name: blackbox-http
    metrics_path: /probe
    static_configs:
{% for target in observability_blackbox_targets %}
      - targets:
          - {{ target.url }}
        labels:
          service: {{ target.name }}
          module: http_{{ target.name | regex_replace('[^A-Za-z0-9_]', '_') }}
{% endfor %}
    relabel_configs:
      - source_labels:
          - module
        target_label: __param_module
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
      - regex: module
        action: labeldrop
{% if observability_dns_targets | length > 0 %}

  - job_name: blackbox-dns
    metrics_path: /probe
    static_configs:
{% for target in observability_dns_targets %}
      - targets:
          - {{ target.address }}
        labels:
          service: {{ target.name }}
          module: dns_{{ target.name | regex_replace('[^A-Za-z0-9_]', '_') }}
{% endfor %}
    relabel_configs:
      - source_labels:
          - module
        target_label: __param_module
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
      - regex: module
        action: labeldrop
{% endif %}
{% if observability_enable_traefik %}

  - job_name: traefik
    static_configs:
      - targets:
          - traefik:8082
{% endif %}
