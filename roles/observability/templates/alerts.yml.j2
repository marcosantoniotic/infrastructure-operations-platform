---
groups:
  - name: application-health
    rules:
      - alert: ApplicationProbeFailed
        expr: probe_success{job="blackbox-http"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Application probe failed: {{ '{{' }} $labels.service {{ '}}' }}"
          description: "The HTTP probe for {{ '{{' }} $labels.instance {{ '}}' }} failed."

      - alert: TLSCertificateExpiringSoon
        expr: >-
          probe_ssl_earliest_cert_expiry{job="blackbox-http"} - time()
          < 30 * 24 * 60 * 60
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate expires within 30 days"
          description: "Certificate for {{ '{{' }} $labels.service {{ '}}' }} is nearing expiry."

      - alert: TLSCertificateExpiringCritical
        expr: >-
          probe_ssl_earliest_cert_expiry{job="blackbox-http"} - time()
          < 15 * 24 * 60 * 60
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "TLS certificate expires within 15 days"
          description: "Certificate for {{ '{{' }} $labels.service {{ '}}' }} requires immediate renewal."

  - name: dns-health
    rules:
      - alert: ManagedDNSProbeFailed
        expr: probe_success{job="blackbox-dns"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Managed DNS probe failed: {{ '{{' }} $labels.service {{ '}}' }}"
          description: "DNS resolution through {{ '{{' }} $labels.instance {{ '}}' }} failed."

      - alert: ManagedDNSLatencyHigh
        expr: probe_duration_seconds{job="blackbox-dns"} > 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Managed DNS latency is above one second"
          description: "DNS probe latency for {{ '{{' }} $labels.service {{ '}}' }} is degraded."

  - name: backup-health
    rules:
      - alert: PlatformBackupFailed
        expr: infrastructure_backup_last_run_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Backup failed: {{ '{{' }} $labels.service {{ '}}' }}"
          description: "The latest scheduled backup execution did not complete successfully."

      - alert: PlatformBackupStale
        expr: >-
          time() - infrastructure_backup_last_success_timestamp_seconds
          > 26 * 60 * 60
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Backup is older than 26 hours: {{ '{{' }} $labels.service {{ '}}' }}"
          description: "No recent successful backup was recorded for this service."

      - alert: ExternalBackupFailed
        expr: infrastructure_external_backup_last_run_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "External backup to {{ '{{' }} $labels.destination {{ '}}' }} failed"
          description: "The latest encrypted external backup did not complete successfully."

      - alert: ExternalBackupStale
        expr: >-
          time() - infrastructure_external_backup_last_success_timestamp_seconds
          > 26 * 60 * 60
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "External backup is older than 26 hours"
          description: "No recent successful encrypted external backup was recorded."

  - name: maintenance-health
    rules:
      - alert: PlatformMaintenanceFailed
        expr: infrastructure_maintenance_last_run_success == 0
        for: 2h
        labels:
          severity: warning
        annotations:
          summary: "The latest platform maintenance failed"
          description: "The maintenance did not complete within two hours; review evidence and preserve the failed state."

      - alert: PlatformMaintenanceOverdue
        expr: >-
          time() - infrastructure_maintenance_last_success_timestamp_seconds
          > 45 * 24 * 60 * 60
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Platform maintenance is overdue"
          description: "No successful maintenance window was recorded within 45 days."
