{% set has_tls_targets = observability_blackbox_targets | selectattr('url', 'match', '^https://') | list | length > 0 %}
{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "FALHA"}, "1": {"color": "green", "text": "OK"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": {{ 6 if has_tls_targets else 8 }}, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{"expr": "min(probe_success{job=\"blackbox-http\"})", "refId": "A"}],
      "title": "Saúde global",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": {{ 6 if has_tls_targets else 8 }}, "x": {{ 6 if has_tls_targets else 8 }}, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [{"expr": "sum(probe_success{job=\"blackbox-http\"} == 0)", "refId": "A"}],
      "title": "Serviços com falha",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1}]},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": {{ 6 if has_tls_targets else 8 }}, "x": {{ 12 if has_tls_targets else 16 }}, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["mean"], "fields": "", "values": false}
      },
      "targets": [{"expr": "avg(probe_duration_seconds{job=\"blackbox-http\"})", "refId": "A"}],
      "title": "Latência média",
      "type": "stat"
    },
{% if has_tls_targets %}
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 15}, {"color": "green", "value": 30}]},
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [{"expr": "min((probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400)", "refId": "A"}],
      "title": "Menor validade TLS",
      "type": "stat"
    },
{% endif %}
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 5},
      "id": 5,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {"expr": "probe_success{job=\"blackbox-http\"}", "format": "table", "instant": true, "refId": "A"},
        {"expr": "probe_http_status_code{job=\"blackbox-http\"}", "format": "table", "instant": true, "refId": "B"},
        {"expr": "probe_duration_seconds{job=\"blackbox-http\"}", "format": "table", "instant": true, "refId": "C"}
      ],
      "title": "Estado atual por aplicação",
      "transformations": [{"id": "merge", "options": {}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never"}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": {{ 12 if has_tls_targets else 24 }}, "x": 0, "y": 13},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [{"expr": "probe_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "{{ '{{' }}service{{ '}}' }}", "refId": "A"}],
      "title": "Latência por aplicação",
      "type": "timeseries"
    }{% if has_tls_targets %},
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never"}, "unit": "d"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 13},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [{"expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400", "legendFormat": "{{ '{{' }}service{{ '}}' }}", "refId": "A"}],
      "title": "Validade dos certificados",
      "type": "timeseries"
    }
{% endif %}
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["infrastructure", "applications", "blackbox", "tls"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Infrastructure Operations — Application & TLS Health",
  "uid": "application-tls-health",
  "version": 1
}
