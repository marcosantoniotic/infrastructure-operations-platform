---
modules:
{% for target in observability_blackbox_targets %}
  http_{{ target.name | regex_replace('[^A-Za-z0-9_]', '_') }}:
    prober: http
    timeout: 10s
    http:
      method: GET
      preferred_ip_protocol: ip4
      follow_redirects: true
{% if target.valid_status_codes is defined %}
      valid_status_codes: {{ target.valid_status_codes | to_json }}
{% endif %}
{% if target.host_header is defined %}
      headers:
        Host: {{ target.host_header | quote }}
{% endif %}
      fail_if_not_ssl: false
      tls_config:
        insecure_skip_verify: {{ target.tls_insecure | default(false) | bool | lower }}
{% endfor %}
{% for target in observability_dns_targets %}
  dns_{{ target.name | regex_replace('[^A-Za-z0-9_]', '_') }}:
    prober: dns
    timeout: 5s
    dns:
      preferred_ip_protocol: ip4
      query_name: {{ target.query_name | quote }}
      query_type: {{ target.query_type | default('A') | quote }}
      valid_rcodes:
        - NOERROR
{% endfor %}
